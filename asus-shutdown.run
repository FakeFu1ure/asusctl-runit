#!/bin/sh
exec 2>&1

export IS_SERVICE=1
export RUST_LOG='info,asus_shutdown=debug,zbus::connection::handshake::common=error,zbus::connection::handshake::client=error'

# Upstream requires both system D-Bus/logind and asusd.  Wait for the bus first.
while [ ! -S /run/dbus/system_bus_socket ]; do
    sleep 0.1
done

# The deferred queue lives in asusd, so ensure it is actually ready before
# acquiring the shutdown inhibitor.
if [ -e /run/runit/service/asusd ]; then
    sv -w 15 start /run/runit/service/asusd || exit 1
fi

# Wait for both required D-Bus names without depending on systemd activation.
i=0
while :; do
    if dbus-send --system --dest=org.freedesktop.DBus --type=method_call --print-reply \
        / org.freedesktop.DBus.NameHasOwner string:xyz.ljones.Asusd 2>/dev/null \
        | grep -q 'boolean true' \
       && dbus-send --system --dest=org.freedesktop.DBus --type=method_call --print-reply \
        / org.freedesktop.DBus.NameHasOwner string:org.freedesktop.login1 2>/dev/null \
        | grep -q 'boolean true'; then
        break
    fi
    i=$((i + 1))
    [ "$i" -lt 150 ] || exit 1
    sleep 0.1
done

exec /usr/bin/asus-shutdown-runit
