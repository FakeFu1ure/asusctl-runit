post_install() {
  cat <<'MSG'

asusctl-runit installed.
Enable/start its runit services with:
  sudo asusctl-runit-setup

The package intentionally does not enable asusd-user on asusctl 6.5.0.

MSG
}

post_upgrade() {
  post_install
}

pre_remove() {
  if command -v asusctl-runit-unsetup >/dev/null 2>&1; then
    asusctl-runit-unsetup || true
  fi
}
